{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "//#quality": {
      "dependsOn": ["//#lint", "//#format"]
    },
    "//#quality:fix": {
      "dependsOn": ["//#format:fix"]
    },
    "//#lint": {
      "inputs": ["**/*.{ts,tsx,js,jsx,mjs,cjs}", "**/.oxlintrc*"]
    },
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {
      "inputs": ["**/*.{ts,tsx,js,jsx,mjs,cjs,json,yaml,yml,md}"]
    },
    "//#format:fix": {
      "dependsOn": ["//#lint:fix"],
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
